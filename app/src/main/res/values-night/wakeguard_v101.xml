<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WakeGuardAlertDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@color/ignido_surface</item>
        <item name="android:colorAccent">#78B9D0</item>
        <item name="android:textColorPrimary">#EAF3F6</item>
        <item name="android:textColorSecondary">#A8BBC4</item>
    </style>
    <style name="WakeGuardThemeNoFlash" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/ignido_midnight</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:alertDialogTheme">@style/WakeGuardAlertDialog</item>
        <item name="android:textColorPrimary">#EAF3F6</item>
        <item name="android:textColorSecondary">#A8BBC4</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/ignido_midnight</item>
        <item name="android:statusBarColor">@color/ignido_midnight</item>
    </style>
</resources>
