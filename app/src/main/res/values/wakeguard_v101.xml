<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WakeGuardAlertDialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@color/ignido_surface</item>
        <item name="android:colorAccent">#23617D</item>
        <item name="android:textColorPrimary">#1A2D3B</item>
        <item name="android:textColorSecondary">#52636D</item>
    </style>
    <style name="WakeGuardThemeNoFlash" parent="@style/AppTheme">
        <item name="android:windowBackground">@color/ignido_midnight</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:alertDialogTheme">@style/WakeGuardAlertDialog</item>
        <item name="android:textColorPrimary">#1A2D3B</item>
        <item name="android:textColorSecondary">#52636D</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:navigationBarColor">@color/ignido_midnight</item>
        <item name="android:statusBarColor">@color/ignido_midnight</item>
    </style>
</resources>
